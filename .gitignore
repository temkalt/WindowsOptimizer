# Dependencies
node_modules/
.pnp
.pnp.js

# Raw source packs and heavy electron/browser builds
packs/
ApexTweak-Desktop/
koltwin-Desktop/
koltwin/
*.exe.config

# Ignore general binaries & media
*.mp4
*.exe
*.dll

# Whitelist utilities in VanDayStuff-Ultimate
